# Configuration du Raspberry Pi : copier en `.env` (jamais commité).
COOP_ID=coop_01
MQTT_HOST=CHANGE_ME_DOMAINE_DU_VPS
MQTT_PORT=8883
MQTT_TLS=true
# Laisser vide pour utiliser les autorités de certification du système (Let's Encrypt).
MQTT_CA_CERT=
# Le nom d'utilisateur MQTT est l'identifiant du poulailler (voir mosquitto/config/acl).
MQTT_USERNAME=coop_01
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
# File d'attente locale des messages non encore envoyés.
OUTBOX_PATH=/var/lib/smartnuggets/outbox.db
# Une commande plus vieille que ça est ignorée (porte qui s'ouvrirait trop tard).
COMMAND_MAX_AGE_S=60
