# Configuration du Raspberry Pi : copier en `.env` (jamais commité).
COOP_ID=coop_01
MQTT_HOST=smartnuggets.be
MQTT_PORT=8883
MQTT_TLS=true
# Laisser vide pour utiliser les autorités de certification du système (Let's Encrypt).
MQTT_CA_CERT=
# Le nom d'utilisateur MQTT est l'identifiant du poulailler (voir mosquitto/config/acl).
MQTT_USERNAME=coop_01
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
# File d'attente locale des messages non encore envoyés.
OUTBOX_PATH=/var/lib/smartnuggets/outbox.db
# Une commande plus vieille que ça est ignorée (porte qui s'ouvrirait trop tard).
COMMAND_MAX_AGE_S=60

# ---- Programme du poulailler (python -m coop_app) ----
# Matériel : "pi" sur le Raspberry Pi 5, "mock" pour tester sur un PC.
HARDWARE=pi
# Caméra : pi, mock, video:/chemin/poule.mp4 ou folder:/chemin/images
CAMERA=pi
# Détecteur : "scripted" (démo) ou "module:Classe" (vrai modèle, voir ai_detector/)
# Sur le vrai Pi, "scripted" ne voit jamais rien : la porte ne s'ouvre alors jamais seule.
# Vrai modèle : DETECTOR=ai_detector.yolo:YoloDetector (pip install -e ".[yolo]")
DETECTOR=scripted
# Modèle YOLO : yolo11n.pt sur PC, yolo11n_ncnn_model sur le Pi (export NCNN, plus rapide)
YOLO_MODEL=yolo11n.pt
HEN_THRESHOLD=0.7
PREDATOR_THRESHOLD=0.5
# Porte verrouillée pendant ce temps après un prédateur (secondes)
PREDATOR_LOCK_S=300
# Photo envoyée avec l'alerte prédateur : réduite sous cette taille (octets)
PHOTO_MAX_BYTES=200000
# Refermer la porte quand plus aucune poule ne passe depuis (secondes)
AUTO_CLOSE_AFTER_S=60
# Plage horaire : la porte ne s'ouvre seule qu'entre ces heures
OPEN_FROM=07:00
CLOSE_AT=21:00
# Moteur 28BYJ-48 : demi-pas entre fermée et ouverte, délai entre deux pas
DOOR_TRAVEL_STEPS=8192
STEP_DELAY_S=0.0015
# Demi-pas en plus tolérés avant de déclarer la porte bloquée
DOOR_MARGIN_STEPS=1024
# Télémétrie envoyée au moins toutes les (secondes) ; poules dans le poulailler au démarrage
HEARTBEAT_S=60
INSIDE_AT_START=0
# Broches (numéros BCM)
MOTOR_PINS=5,6,13,19
TOP_PIN=23
BOTTOM_PIN=24
BEAM_OUTER_PIN=27
BEAM_INNER_PIN=22
MOTION_PIN=17
