# Modèle de configuration : copier en `.env` (jamais commité) et remplacer les CHANGE_ME.
# En développement local, aucun .env n'est nécessaire : l'API utilise alors SQLite
# (sqlite+aiosqlite:///./smartnuggets.db).

POSTGRES_USER=smartnuggets_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=smartnuggets_db
DATABASE_URL=postgresql+asyncpg://smartnuggets_user:CHANGE_ME_STRONG_PASSWORD@db:5432/smartnuggets_db

# Broker MQTT (voir mosquitto/README.md). Dans Docker, l'API utilise le port interne 1883.
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=backend_service
MQTT_PASSWORD=CHANGE_ME_MQTT_SECRET

# Dossier des photos d'alertes envoyées par le Raspberry Pi
MEDIA_DIR=/app/media

# Authentification : clé de signature des jetons (64 caractères hexadécimaux)
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origines autorisées pour le frontend (format JSON)
CORS_ORIGINS=["https://smartnuggets.be"]

# Durées de conservation (RGPD) : photos d'alerte, puis passages et alertes (jours)
PHOTO_RETENTION_DAYS=30
DATA_RETENTION_DAYS=365

# Santé du Raspberry Pi : délai avant "hors ligne" + alerte, seuil de batterie faible
DEVICE_OFFLINE_AFTER_S=900
LOW_BATTERY_THRESHOLD=20
